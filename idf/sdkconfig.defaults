# Target: XIAO ESP32-S3 Sense, 8 MB flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Arduino as a component
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ARDUINO_VARIANT="esp32s3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# lwIP (WireGuard over UDP needs fragmentation and reassembly)
CONFIG_LWIP_IP4_FRAG=y
CONFIG_LWIP_IP4_REASSEMBLY=y

# MicroLink: no compiled-in key, no config web server (key comes from NVS only)
CONFIG_ML_TAILSCALE_AUTH_KEY=""
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
CONFIG_ML_ENABLE_CELLULAR=n
CONFIG_ML_ENABLE_NET_SWITCH=n

# MicroLink requirements (from its README and ESP32-S3 example)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# WireGuard encrypts in the lwIP tcpip thread (tiT). The default 3072 bytes overflowed
# during an RTSP stream over the tailnet (docs/debugging/2026-10-30_tailnet-rtsp-panics.md).
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144

# A TCP sender has at most one send buffer in flight per round trip. The 48 kHz stream needs
# ~99 KB/s, so the default 5760 bytes dropped audio to a BirdNET-Go ~62 ms away. 14400 bytes
# (10 segments) covers up to ~150 ms.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=14400

# MicroLink's ml_wg_mgr task calls lwIP and wireguardif outside the tcpip thread; the fork
# of MicroLink holds the core lock for those calls. The checker asserts on any raw lwIP
# call made without the lock (same debugging file).
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
